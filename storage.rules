rules_version = '2';

// =====================================================================
// Cloud Storage Rules — GangTalk
// 신설일: 2026-06-18 (보고서 §2-4 E)
// 기본 원칙:
//   - 읽기는 공개 (이미지 표시용. CDN 캐시 / 무제한 노출)
//   - 쓰기는 경로별 소유자 / 관리자 / 인증사용자 제한
//   - admins/{uid} 문서 존재 = 관리자 판별 (firestore.rules 와 동일 기준)
// 경로 인벤토리:
//   stores/{storeId}/*           — 업체 본인 + 관리자
//   marketing/**                 — 관리자만 (배너, partnerCards)
//   board_images/{uid}/**        — 작성자 본인 + 관리자
//   partnerRequests/{uid}/**     — 본인 + 관리자
//   profiles/{uid}/**            — 본인 + 관리자
//   그 외                        — 인증된 사용자 (기본)
// =====================================================================
service firebase.storage {
  match /b/{bucket}/o {

    // ----- 공통 함수 -----
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function isStoreOwner(storeId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/stores/$(storeId))
        && firestore.get(/databases/(default)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }
    function isImage() {
      return request.resource == null
        || request.resource.contentType == null
        || request.resource.contentType.matches('image/.*');
    }
    function sizeOk() {
      // 업로드 사이즈 캡 — 10MB
      return request.resource == null
        || request.resource.size < 10 * 1024 * 1024;
    }

    // ===== 가게 이미지 (stores/{storeId}/*) =====
    //   write 는 해당 stores 의 ownerId == 본인 또는 관리자만.
    //   StoreEditPage.vue:808 (`stores/${draftId}/thumb-${ts}.jpg`) 와
    //   BizMyStorePage 의 향후 업로드 (PR-C) 가 이 경로 사용.
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isAdmin() || isStoreOwner(storeId)) && isImage() && sizeOk();
    }

    // ===== 마케팅 자산 (배너, partnerCards) =====
    //   관리자만 쓰기. BannersManagePage / AdminTools / useMyPageCore 사용.
    match /marketing/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && sizeOk();
    }

    // ===== 게시판 이미지 (board_images/{uid}/...) =====
    //   본인만 업로드. GangTalkPage.vue:1691.
    match /board_images/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == uid || isAdmin())
                && isImage() && sizeOk();
    }

    // ===== 제휴 신청 자료 (partnerRequests/{uid}/...) =====
    //   본인만 업로드. PartnerRequestPage.vue:538.
    match /partnerRequests/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == uid || isAdmin())
                && isImage() && sizeOk();
    }

    // ===== 프로필 이미지 (profiles/{uid}/...) =====
    //   본인만 업로드. ProfileEditSheet.vue:545.
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if (signedIn() && request.auth.uid == uid || isAdmin())
                && isImage() && sizeOk();
    }

    // ===== 폴백 — 그 외 경로 =====
    //   인증된 사용자만 read/write. 알 수 없는 경로에 임의 업로드 차단.
    //   필요 시 별도 match 룰 추가.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && sizeOk();
    }
  }
}
